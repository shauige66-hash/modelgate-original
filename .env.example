# ============================================================
# ModelGate 配置示例
# 复制为 .env 后按需修改：copy .env.example .env
# .env 已在 .gitignore 中，不会提交到仓库。
# ============================================================

# ===== 应用 =====
APP_NAME=ModelGate
APP_VERSION=0.2.0
APP_DEBUG=false
LOG_LEVEL=INFO

# ===== 模型注册表 =====
# 只有登记在此的模型才会被转发；格式 模型名:服务商，多个用英文逗号分隔。
# 模型名不参与 URL 构造，上游地址只能来自下面的 *_BASE_URL，
# 因此调用方无法通过 model 字段把请求指向任意目标。
# 未登记的模型会返回 400，不会静默回落到默认服务商。
MODEL_REGISTRY=deepseek-chat:deepseek,deepseek-reasoner:deepseek,gpt-4o-mini:openai
# 未指定 model 时使用的默认模型，必须已登记在 MODEL_REGISTRY 中
DEFAULT_MODEL_NAME=deepseek-chat

# ===== 服务商：DeepSeek =====
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 【必填】你的 DeepSeek API Key，务必不要提交到 Git
DEEPSEEK_API_KEY=sk-replace-with-your-real-key
# 单价（美元 / 百万 Token）。留空或填 0 表示价格未知，
# 成本会记为未知而不是 0。请按官方当前价格填写，下列数值仅为占位示例。
DEEPSEEK_PRICE_INPUT_PER_MILLION_USD=0.27
DEEPSEEK_PRICE_OUTPUT_PER_MILLION_USD=1.10

# ===== 服务商：OpenAI =====
OPENAI_BASE_URL=https://api.openai.com
# 留空表示该服务商不可用：请求 openai 的模型会返回 503，不会发往任何上游
OPENAI_API_KEY=
OPENAI_PRICE_INPUT_PER_MILLION_USD=
OPENAI_PRICE_OUTPUT_PER_MILLION_USD=

# ===== 单模型价格覆盖（可选） =====
# 格式 模型名:输入价:输出价，多个用英文逗号分隔；优先级高于服务商默认价。
# 适用于同一服务商下不同模型价格差异较大的情况，例如
# MODEL_PRICES=gpt-4o-mini:0.15:0.60,gpt-4o:2.50:10.00
MODEL_PRICES=

# ===== 上游请求参数 =====
# 单次上游请求超时（秒）。LLM 推理较慢，通常需要 30~120
UPSTREAM_TIMEOUT_SECONDS=60
# 每个服务商各自持有独立的 HTTP 连接池
UPSTREAM_MAX_CONNECTIONS=100
UPSTREAM_MAX_KEEPALIVE_CONNECTIONS=20

# ===== 并发控制（仅在单个进程内生效，不是分布式限流） =====
MAX_CONCURRENT_REQUESTS=8
# 等待并发槽位的上限（秒），超时返回 503
CONCURRENCY_ACQUIRE_TIMEOUT_SECONDS=10

# ===== Agent 调用追踪 =====
# X-Client-App / X-Agent-Name / X-Run-Id 三个可选请求头的长度上限。
# 这些是客户端自报的观测标签，只用于统计与检索，不参与鉴权或权限判断。
AGENT_TAG_MAX_LENGTH=64

# ===== 配额（默认全部关闭；单位是请求次数，不是 Token 或金额） =====
# 留空或填 0 表示该维度不限制。启用后超限返回 429 quota_exceeded，
# 且被拒绝的请求不会调用上游模型。
#
# 客户端维度：按网关 API Key 的指纹统计，每个 UTC 自然日 00:00 重置。
# 注意身份用的是已认证 Key 的指纹，不是客户端自填的 X-Client-App。
CLIENT_DAILY_REQUEST_QUOTA=0
#
# Run 维度：按「Key 指纹 + X-Run-Id」统计，覆盖**整个 Run 生命周期**，
# 不随 UTC 日切重置 —— 一次 Agent 工作流跨过零点不会重新获得额度。
# 只在请求带 X-Run-Id 时生效；不带该头的请求不受此限制。
RUN_MAX_LLM_CALLS=0
#
# 说明：本项只做请求计数，没有金额预留与结算，
# 因此它**不是** Token 或美元预算的硬上限。成本控制请另行处理。

# ===== 可靠性（默认不重试） =====
# 1 表示不重试。大于 1 时才启用重试。
#
# ⚠️ LLM 请求不是幂等的：读取超时无法判断上游是否已经开始推理。
# 重试可能导致**重复推理与重复计费**，因此默认关闭，且只对「请求确定未送达」
# 的故障（连接建立失败）才是安全的。读取超时、429、5xx 默认都按不可重试处理，
# 需要显式打开下面的开关才会重试。
RETRY_MAX_ATTEMPTS=1
# 退避基数（秒），第 n 次重试等待 RETRY_BACKOFF_BASE_SECONDS * 2^(n-1)
RETRY_BACKOFF_BASE_SECONDS=0.5
# 单次重试的最大等待（秒），避免退避时间失控
RETRY_BACKOFF_MAX_SECONDS=8
# 是否重试读取超时。默认关闭 —— 无法确认上游是否已在推理。
RETRY_ON_READ_TIMEOUT=false
# 是否重试上游 429 / 5xx。默认关闭。
RETRY_ON_UPSTREAM_ERROR=false

# ===== 鉴权 =====
# 客户端调用 /v1/* 使用的 Key，多个用英文逗号分隔
CLIENT_API_KEYS=sk-client-local-dev-key
# 管理接口 /admin/* 使用的独立 Key，不要和客户端 Key 相同
ADMIN_API_KEY=sk-admin-local-dev-key

# ===== 数据库 =====
# Docker Compose 场景：主机名是服务名 db
DATABASE_URL=postgresql+asyncpg://modelgate:modelgate@db:5432/modelgate
# 在本机直接运行（不用 Docker）时改成：
# DATABASE_URL=postgresql+asyncpg://modelgate:modelgate@127.0.0.1:5432/modelgate
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 设为 true 会打印所有 SQL，调试时临时开启
DB_ECHO=false

# ===== 仅 Docker Compose 使用 =====
# PostgreSQL 容器初始化参数（会被 docker-compose.yml 读取）
# ⚠️ 这些是本地开发占位值，强度极低。放到本机以外的环境前必须修改。
# 另外 db 端口在 docker-compose.yml 中已限制为 127.0.0.1:5432，
# 避免 PostgreSQL 被局域网或公网直接访问。
POSTGRES_USER=modelgate
POSTGRES_PASSWORD=modelgate
POSTGRES_DB=modelgate

# ===== 仅测试使用（不要写进 .env，用命令行临时设置） =====
# PostgreSQL 集成测试需要，必须指向**专用测试库**，库名以 _test 结尾。
# 该测试会 drop_all + create_all 清空目标库的表，
# 因此绝不能指向上面 DATABASE_URL 所在的业务库 —— 守卫会拒绝启动并报错。
#
#   docker compose exec db psql -U modelgate -d postgres -c "CREATE DATABASE modelgate_test;"
#   $env:TEST_DATABASE_URL="postgresql+asyncpg://modelgate:modelgate@127.0.0.1:5432/modelgate_test"
#   .\.venv\Scripts\python.exe -m pytest -q
