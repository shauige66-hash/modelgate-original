# 统一换行符，避免 Windows 上编辑的 CRLF 进入 Linux 容器。
# 容器内以 LF 运行最稳妥；文本文件统一按 LF 存储与检出。
* text=auto eol=lf

# 明确标记为文本的文件类型
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.ini   text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
Dockerfile       text eol=lf
.dockerignore    text eol=lf
.gitignore       text eol=lf
.gitattributes   text eol=lf

# Windows 脚本保留 CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
