# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment / secrets
#
# 用 .env.* 覆盖所有环境变体（.env.local / .env.production / .env.staging ...），
# 再用 ! 把 .env.example 显式排除在忽略之外。
# 顺序很重要：后面的 ! 规则会覆盖前面的忽略规则。
# .env.example 只包含占位值，是配置模板，必须提交。
.env
.env.*
!.env.example

# 本地 SQLite 数据库文件（单元测试用内存库，不产生文件；
# 这里是防止手工调试时把产物提交上去）
*.db
*.sqlite3

# 测试与基准的临时产物（日志、临时数据卷导出等）
benchmarks/_*.log
tests/_*.log
*.tmp

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
